{
  "name": "matjari",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["web"],
  "engines": { "node": ">=22.17.0", "npm": ">=10" },
  "scripts": {
    "dev": "npm run dev --workspace web",
    "dev:api": "cargo run --manifest-path backend/Cargo.toml -- serve",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npm run test --workspace web",
    "test:e2e": "npm run test:e2e --workspace web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "setup:env": "node scripts/dev-env.mjs"
  }
}
